{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/tmp",
			"!deno.lock",
			"!pnpm-lock.yaml",
			"!pnpm-workspace.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 90
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"yaml": {
		"formatter": {
			"indentWidth": 2
		}
	},
	"markdown": {
		"parser": {
			"frontmatter": true
		}
	},
	"overrides": [
		{
			"includes": ["**/package.json", "**/deno.json", "**/jsr.json"],
			"json": {
				"formatter": {
					"indentStyle": "space",
					"indentWidth": 2
				}
			}
		}
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "warn",
				"useTemplate": "warn"
			},
			"complexity": {
				"noUselessCatch": "warn",
				"noUselessEscapeInRegex": "warn",
				"useDateNow": "warn",
				"useLiteralKeys": "warn"
			},
			"performance": {
				"noAccumulatingSpread": "warn"
			},
			"suspicious": {
				"noAssignInExpressions": "warn",
				"noConfusingVoidType": "warn",
				"noControlCharactersInRegex": "warn",
				"noDoubleEquals": "warn",
				"noExplicitAny": "warn",
				"noGlobalIsNan": "warn",
				"noImplicitAnyLet": "warn",
				"noPrototypeBuiltins": "warn",
				"noTemplateCurlyInString": "warn",
				"noTsIgnore": "warn",
				"useIterableCallbackReturn": "warn"
			}
		}
	}
}
