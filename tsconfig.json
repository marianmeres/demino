{
  "compilerOptions": {
    "target": "es2024",
    // "dom" because @types/node declares Request/Response/Headers/WebSocket as
    // globals but not the fetch helper names src/ uses (BodyInit, HeadersInit,
    // RequestCache, ErrorEvent) - those exist only in lib.dom
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
