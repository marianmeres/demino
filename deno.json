{
  "name": "@marianmeres/demino",
  "version": "1.18.0",
  "exports": {
    ".": "./src/mod.ts",
    "./deno": "./src/deno.ts",
    "./node": "./src/node.ts",
    "./bun": "./src/bun.ts",
    "./middleware": "./src/middleware.ts",
    "./misc": "./src/misc.ts",
    "./router": "./src/router.ts",
    "./utils": "./src/utils.ts"
  },
  "nodeModulesDir": "none",
  "exclude": [
    "node_modules",
    ".npm-dist"
  ],
  "tasks": {
    "dev": "deno run --watch ./src/mod.ts",
    "test": "deno test -A tests/",
    "test:watch": "deno test -A --watch tests/",
    "typecheck": "npm run typecheck",
    "npm:build": "deno run -A scripts/build-npm.ts",
    "npm:smoke": "deno task npm:build && node scripts/smoke-npm.mjs",
    "npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
    "release": "deno run -A jsr:@marianmeres/release",
    "publish": "deno publish && deno task npm:publish",
    "rp": "deno task release -y && deno task publish",
    "rpm": "deno task release minor -y && deno task publish"
  },
  "imports": {
    "@marianmeres/clog": "jsr:@marianmeres/clog@^3.21.0",
    "@marianmeres/http-utils": "jsr:@marianmeres/http-utils@^2.12.0",
    "@marianmeres/midware": "jsr:@marianmeres/midware@^1.5.0",
    "@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
    "@marianmeres/simple-router": "jsr:@marianmeres/simple-router@^3.4.0",
    "mrmime": "npm:mrmime@^2.0.1",
    "@marianmeres/mcp-server/types": "jsr:@marianmeres/mcp-server@^1.3.2/types",
    "ws": "npm:ws@^8.18"
  },
  "publish": {
    "exclude": [
      ".*",
      "scripts/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json"
    ]
  },
  "fmt": {
    "useTabs": true,
    "lineWidth": 90,
    "indentWidth": 4
  }
}
